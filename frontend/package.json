{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.ts,.vue src tests",
    "format": "prettier --write .",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prepare": "cd .. && husky frontend/.husky"
  },
  "dependencies": {
    "@primeuix/themes": "^3.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tato30/vue-pdf": "^2.2.0",
    "axios": "^1.20.0",
    "dompurify": "^3.4.15",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.13",
    "pdf-lib": "^1.17.1",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primevue": "^5.0.1",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@playwright/test": "^1.63.0",
    "@primevue/auto-import-resolver": "^5.0.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "lint-staged": "^17.5.1",
    "prettier": "3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.3.5",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-sitemap": "^0.8.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,jsx,vue}": [
      "pnpm exec eslint --ext .js,.ts,.vue src tests",
      "pnpm exec prettier --write ."
    ]
  }
}
